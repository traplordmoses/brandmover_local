# =============================================================================
# BrandMover Local — Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values.
# Required settings are marked with (REQUIRED). Everything else has defaults.
# =============================================================================

# =============================================================================
# CORE
# =============================================================================

# Brand identity and folder paths
BRAND_NAME=MyBrand                  # Used in system prompts and generation context
BRAND_FOLDER=./brand                # Root directory for brand assets (guidelines.md, prompts/, etc.)
STATE_FOLDER=./state                # Runtime state files (pending drafts, feedback, history)
REFERENCES_FOLDER=                  # Path to reference docs (default: BRAND_FOLDER/references/)
TIMEZONE=                           # IANA timezone, e.g. "America/Chicago" (default: system local)

# Override which .env file is loaded (useful for multi-brand instances)
# BRANDMOVER_ENV_FILE=/path/to/.env.brand2

# =============================================================================
# TELEGRAM (REQUIRED)
# =============================================================================

TELEGRAM_BOT_TOKEN=                 # (REQUIRED) Bot token from @BotFather
TELEGRAM_ALLOWED_USER_ID=           # (REQUIRED) Admin user ID (full access to all commands)
TELEGRAM_OPERATOR_IDS=              # Comma-separated user IDs with limited operator access
TELEGRAM_MONITOR_CHANNELS=          # Comma-separated channel/group IDs for silent message logging

# =============================================================================
# API KEYS
# =============================================================================

# --- LLM Providers ---
LLM_PROVIDER=anthropic              # Primary LLM provider: "anthropic" or "gemini"
ANTHROPIC_API_KEY=                  # (REQUIRED) Anthropic API key for Claude
OPENAI_API_KEY=                     # OpenAI key — used for Whisper voice transcription
GEMINI_API_KEY=                     # Google Gemini key — alternative LLM provider

# --- Image Generation (Replicate) ---
REPLICATE_API_TOKEN=                # Replicate API token for image generation
IMAGE_MODEL=auto                    # "auto" routes by content type, or force a specific model:
                                    # black-forest-labs/flux-1.1-pro (default/general)
                                    # google/nano-banana-pro (text overlays/announcements)
                                    # recraft-ai/recraft-v3-svg (brand assets/icons)
                                    # bytedance/seedream-4.5 (lifestyle/photography)

# --- X / Twitter ---
X_API_KEY=                          # OAuth 1.0a consumer key
X_API_SECRET=                       # OAuth 1.0a consumer secret
X_ACCESS_TOKEN=                     # OAuth 1.0a access token
X_ACCESS_SECRET=                    # OAuth 1.0a access secret
X_BEARER_TOKEN=                     # Bearer token (for read-only endpoints)

# --- Discord (optional) ---
DISCORD_BOT_TOKEN=                  # Bot token from discord.com/developers
DISCORD_GUILD_ID=                   # Server ID (right-click server -> Copy Server ID)

# --- ElevenLabs TTS (optional) ---
ELEVENLABS_API_KEY=                 # ElevenLabs key for video voiceover (falls back to OpenAI TTS)
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM  # Voice ID (default: "Rachel")

# --- Figma (optional) ---
FIGMA_ACCESS_TOKEN=                 # Figma personal access token for design checks
FIGMA_FILE_KEY=                     # Figma file key (from URL: figma.com/file/<KEY>/...)
FIGMA_NODE_ID=                      # Node ID to fetch design tokens from (e.g. "0:5")

# =============================================================================
# AGENT
# =============================================================================

AGENT_MODE=agent                    # "agent" (Claude tool-use loop) or "pipeline" (legacy 4-step)
AGENT_MAX_TURNS=15                  # Max LLM round-trips per request (higher = more tool calls, more cost)
AGENT_MODEL=claude-sonnet-4-6      # Model for agent tool-use loop (set to claude-opus-4-6 for max quality)
AGENT_SELF_CRITIQUE=true            # Agent reviews its own output before returning
AGENT_FALLBACK_MODELS=              # Comma-separated fallback chain when primary model fails (429/500/503)
SONNET_MODEL=claude-sonnet-4-6     # Model for pipeline, chat, feedback, ingestion
HAIKU_MODEL=claude-haiku-4-5-20251001  # Model for intent routing, lightweight tasks
CHAT_MAX_TOKENS=600                 # Max tokens for chat responses
UNIFIED_BRAIN_ENABLED=false         # Route ALL messages through unified_brain.py (single LLM loop)
INTENT_ROUTER_ENABLED=true          # Classify messages before routing (saves cost on simple commands)

# --- Pipeline (legacy mode) ---
PIPELINE_MODE=full                  # "full" (4-step) or "fast" (3-step, merges plan+verify)
MAX_REFERENCE_CHARS=50000           # Max chars loaded from brand/references/

# =============================================================================
# CONTENT GENERATION
# =============================================================================

# --- Feedback & Learning ---
FEEDBACK_SUMMARIZE_EVERY=10         # After N feedback entries, auto-summarize patterns into preferences
PREF_EXTRACTION_ENABLED=true        # Auto-analyze approval/rejection patterns to learn preferences
PREF_EXTRACTION_MIN_EVENTS=5        # Minimum events before running preference extraction
PREF_EXTRACTION_INTERVAL_HOURS=24   # Hours between preference extraction runs

# --- Draft Scoring ---
DRAFT_SCORE_ENABLED=true            # Score drafts against learned approval/rejection patterns
DRAFT_SCORE_THRESHOLD=6.0           # Minimum score (1-10) to pass; drafts below are flagged

# --- Content Mix ---
CONTENT_MIX_RATIOS=educational:25,community:20,announcement:20,engagement:15,lifestyle:10,meme:10
                                    # Relative weights for auto-post content type distribution

# --- Topic Bank ---
TOPIC_BANK_REFRESH_INTERVAL_HOURS=72  # Hours between topic bank refreshes with new Claude-generated angles

# --- Cost Gate ---
DAILY_COST_BUDGET_USD=5.0           # Daily budget cap for image generation spend (USD)

# --- Voice ---
WHISPER_ENABLED=true                # Transcribe voice messages via OpenAI Whisper (auto-enabled if OPENAI_API_KEY set)

# =============================================================================
# SCHEDULING
# =============================================================================

# --- Auto Post ---
AUTO_POST_ENABLED=false             # Enable scheduled auto-posting
AUTO_POST_SCHEDULE_FILE=            # Path to schedule.json (default: config/schedule.json)
AUTO_POST_STATE_FILE=               # Path to auto_post_state.json (default: state/auto_post_state.json)
AUTO_POST_DRY_RUN=false             # Generate content without actually posting to X

# --- Heartbeat ---
HEARTBEAT_ENABLED=true              # Use heartbeat reasoning layer (assess -> reason -> dispatch)
HEARTBEAT_PROACTIVE_HOURS=8         # Hours without a post before heartbeat triggers proactive generation

# --- Content Planner ---
CONTENT_PLANNER_ENABLED=false       # Use rolling content plan instead of slot-based scheduling
PLAN_HORIZON_DAYS=7                 # How many days ahead the planner maintains

# =============================================================================
# MONITORING
# =============================================================================

DAILY_DIGEST_ENABLED=true           # Send daily performance summary via Telegram
DAILY_DIGEST_HOUR=21                # Hour (UTC) to send the daily digest
HEALTH_CHECK_ENABLED=true           # Run periodic system health checks
HEALTH_ALERT_ENABLED=true           # Send Telegram alerts on health check failures

# =============================================================================
# MULTI-PLATFORM
# =============================================================================

PUBLISH_PLATFORMS=x                 # Comma-separated platforms to publish on /approve: x, discord, telegram
DISCORD_CROSSPOST_ENABLED=false     # Auto-cross-post to Discord (auto-enabled if DISCORD_BOT_TOKEN is set)

# =============================================================================
# ADVANCED
# =============================================================================

# --- Context Feed ---
CONTEXT_FEED_ENABLED=true           # Aggregate on-chain events and X mentions into auto-post prompts
X_MENTIONS_ENABLED=false            # Poll X for mentions to use as content context
X_MENTIONS_POLL_MINUTES=30          # Minutes between X mentions polling
EVENT_TRIGGER_ENABLED=true          # Trigger content generation on on-chain events

# --- OpenClaw ---
OPENCLAW_SCRIPTS_DIR=               # Path to OpenClaw scripts (~/.openclaw/skills/brand-mover/scripts)
